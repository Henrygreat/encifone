// EncifOne — identity/platform (Phase 1) + CRM foundation (Phase 2.1) schema.
// See docs/DATABASE_SCHEMA.md for the full planned domain model.
// Additional domain modules (sales, projects, finance, ...) are added
// in their own phases per docs/MASTER_ROADMAP.md, not scaffolded ahead of need.

generator client {
  provider = "prisma-client-js"
}

// The connection URL lives in prisma.config.ts (Prisma 7+ no longer reads it
// from the schema file) and in the PrismaPg adapter passed to PrismaClient
// at runtime (src/lib/prisma.ts) — both read DATABASE_URL from the environment.
datasource db {
  provider = "postgresql"
}

// --- Auth.js (next-auth) required models ---
// Field/model names follow the next-auth Prisma adapter contract exactly.

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Identity ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  // Null for users who have only ever authenticated via OAuth.
  passwordHash  String?
  // Stub only — no TOTP enrolment/challenge flow is implemented yet (Phase 1).
  mfaEnabled    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts    Account[]
  sessions    Session[]
  memberships Membership[]
}

model Organisation {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  // Logo/colour-token overrides — see docs/DESIGN_SYSTEM.md §6 (white-label & theming).
  branding        Json?
  defaultCurrency String   @default("GBP")
  timezone        String   @default("Europe/London")
  // Lead-to-client conversion gating (docs/MASTER_ROADMAP.md 2.7). Both
  // default false, matching the Phase 2B behaviour already shipped and
  // tested (moveOpportunity creates a Client immediately on entering a
  // Won stage) — turning either on is an explicit, additive opt-in, never
  // a silent behaviour change for an org that hasn't configured this.
  conversionRequiresContract Boolean  @default(false)
  conversionRequiresPayment  Boolean  @default(false)
  // Phase 3 — when true and the org has a default OnboardingTemplate,
  // creating a Client (ensureClientFromWonOpportunity, or Stripe/contract-
  // gated conversion) automatically opens a ClientOnboarding against it.
  // Default false: an org that hasn't configured a template sees no
  // behaviour change, same opt-in pattern as the conversion-gating flags.
  autoStartOnboarding        Boolean  @default(false)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  memberships         Membership[]
  auditLogs           AuditLog[]
  companies           Company[]
  contacts            Contact[]
  leads               Lead[]
  customFields        CustomFieldDefinition[]
  customValues        CustomFieldValue[]
  pipelines           Pipeline[]
  opportunities       Opportunity[]
  activities          Activity[]
  clients             Client[]
  serviceItems        ServiceItem[]
  proposals           Proposal[]
  savedViews          SavedView[]
  contractTemplates   ContractTemplate[]
  contracts           Contract[]
  payments            Payment[]
  aiConfig            AIOrganisationConfig?
  clientPortalUsers   ClientPortalUser[]
  onboardingTemplates OnboardingTemplate[]
  clientDocuments     ClientDocument[]
  notifications       Notification[]
  aiUsageLogs       AIUsageLog[]
}

enum MembershipRole {
  PLATFORM_SUPER_ADMIN
  ORGANISATION_OWNER
  ORGANISATION_ADMIN
  OPERATIONS_MANAGER
  SALES_MANAGER
  SALES_REPRESENTATIVE
  ACCOUNT_MANAGER
  FINANCE_MANAGER
  PROJECT_MANAGER
  TEAM_MEMBER
  CONTRACTOR
  CLIENT_ADMINISTRATOR
  CLIENT_USER
  READ_ONLY_AUDITOR
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

model Membership {
  id             String           @id @default(cuid())
  userId         String
  organisationId String
  role           MembershipRole
  status         MembershipStatus @default(ACTIVE)
  // The org a user lands in by default on login; exactly one per user should be true
  // (enforced in the service layer, not a DB constraint, since it spans rows).
  isDefault      Boolean          @default(false)
  // Set when status = INVITED; cleared once the invite is accepted.
  inviteToken    String?          @unique
  invitedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  ownedCompanies     Company[]     @relation("CompanyOwner")
  ownedContacts      Contact[]     @relation("ContactOwner")
  ownedLeads         Lead[]        @relation("LeadOwner")
  ownedOpportunities Opportunity[] @relation("OpportunityOwner")
  ownedActivities    Activity[]    @relation("ActivityOwner")
  ownedClients       Client[]      @relation("ClientOwner")
  ownedProposals     Proposal[]    @relation("ProposalOwner")
  ownedSavedViews    SavedView[]   @relation("SavedViewOwner")
  ownedContracts     Contract[]    @relation("ContractOwner")

  completedOnboardingSteps ClientOnboardingStep[] @relation("StepCompletedByMembership")
  approvedOnboardingSteps  ClientOnboardingStep[] @relation("StepApprovedByMembership")
  uploadedDocuments        ClientDocument[]       @relation("DocumentUploadedByMembership")
  reviewedDocuments        ClientDocument[]       @relation("DocumentReviewedByMembership")
  receivedNotifications    Notification[]         @relation("NotificationRecipientMembership")

  @@unique([userId, organisationId])
  @@index([organisationId, status])
}

// Immutable append-only audit trail. Never updated or deleted by application code.
model AuditLog {
  id             String   @id @default(cuid())
  // Null for platform-level actions with no single owning organisation.
  organisationId String?
  actorUserId    String?
  action         String
  resourceType   String
  resourceId     String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)

  @@index([organisationId, createdAt])
}

// --- CRM foundation (Phase 2.1) ---
// See docs/MASTER_ROADMAP.md Phase 2.1 and docs/DATABASE_SCHEMA.md §3 (CRM).

enum CompanyStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ContactStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
  LOST
  ARCHIVED
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
}

model Company {
  id                  String        @id @default(cuid())
  organisationId      String
  name                String
  tradingName         String?
  registrationNumber  String?
  industry            String?
  companySize         String?
  website             String?
  email               String?
  phone               String?
  billingAddress      Json?
  operatingAddress    Json?
  country             String?
  currency            String        @default("GBP")
  taxRegistrationNumber String?
  ownerId             String?
  status              CompanyStatus @default(ACTIVE)
  logoUrl             String?
  parentCompanyId     String?
  tags                String[]      @default([])
  notes               String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  deletedAt           DateTime?

  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  owner          Membership?  @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  parentCompany  Company?     @relation("CompanyHierarchy", fields: [parentCompanyId], references: [id], onDelete: SetNull)
  subsidiaries   Company[]    @relation("CompanyHierarchy")
  contacts       Contact[]
  leads          Lead[]
  opportunities  Opportunity[]
  clients        Client[]
  proposals      Proposal[]
  contracts      Contract[]
  payments       Payment[]

  @@index([organisationId, status])
  @@index([organisationId, name])
  @@index([organisationId, deletedAt])
}

model Contact {
  id                        String        @id @default(cuid())
  organisationId            String
  companyId                 String?
  firstName                 String
  lastName                  String
  jobTitle                  String?
  department                String?
  // Each entry: { address, label, isPrimary }
  emails                    Json          @default("[]")
  // Each entry: { number, label, isPrimary }
  phones                    Json          @default("[]")
  preferredChannel          String?
  timezone                  String?
  language                  String?
  ownerId                   String?
  status                    ContactStatus @default(ACTIVE)
  leadSource                String?
  communicationPreferences  Json?
  marketingConsent          Boolean       @default(false)
  tags                      String[]      @default([])
  notes                     String?
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt
  deletedAt                 DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  company       Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner         Membership?   @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  leads         Lead[]
  opportunities Opportunity[]
  clients       Client[]
  proposals     Proposal[]
  contracts     Contract[]
  payments      Payment[]

  @@index([organisationId, status])
  @@index([organisationId, companyId])
  @@index([organisationId, deletedAt])
}

model Lead {
  id                  String       @id @default(cuid())
  organisationId      String
  firstName           String?
  lastName             String?
  email                String?
  phone                String?
  // Free-text until qualified onto a real Company record.
  companyName          String?
  companyId            String?
  contactId            String?
  source               String?
  status               LeadStatus   @default(NEW)
  priority             LeadPriority @default(MEDIUM)
  estimatedValueMinor  Int?
  currency             String       @default("GBP")
  ownerId              String?
  nextFollowUpAt       DateTime?
  convertedAt          DateTime?
  rejectedReason       String?
  // Schema foundation only — AI-generated scoring itself is Phase 2.8.
  score                Int?
  tags                 String[]     @default([])
  notes                String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  deletedAt            DateTime?

  organisation     Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  company          Company?              @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact          Contact?              @relation(fields: [contactId], references: [id], onDelete: SetNull)
  owner            Membership?           @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  ownershipHistory LeadOwnershipHistory[]

  @@index([organisationId, status])
  @@index([organisationId, ownerId])
  @@index([organisationId, deletedAt])
}

// "Lead ownership history" (docs/PRODUCT_REQUIREMENTS.md §6.2) — a dedicated
// append-only table rather than overloading AuditLog, since reassignment
// needs structured from/to querying (e.g. "leads this rep used to own").
model LeadOwnershipHistory {
  id          String   @id @default(cuid())
  leadId      String
  fromOwnerId String?
  toOwnerId   String?
  changedAt   DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, changedAt])
}

enum CustomFieldEntityType {
  COMPANY
  CONTACT
  LEAD
}

enum CustomFieldType {
  TEXT
  LONG_TEXT
  NUMBER
  CURRENCY
  DATE
  DATETIME
  BOOLEAN
  SELECT
  MULTI_SELECT
  URL
  EMAIL
  PHONE
}

// Org-defined extra fields on Company/Contact/Lead. Values are stored
// separately (CustomFieldValue) in a polymorphic entity-attribute-value
// table — Prisma has no native polymorphic relation, so entityId is a
// plain string resolved against `entityType` in the service layer, never
// trusted as a foreign key by the database itself. Known tradeoff: EAV
// doesn't suit heavy cross-object BI at scale — acceptable for Phase 2.1's
// org-defined-fields use case; a materialised reporting layer can be added
// later without changing this table (see docs/DATABASE_SCHEMA.md).
model CustomFieldDefinition {
  id             String                @id @default(cuid())
  organisationId String
  entityType     CustomFieldEntityType
  key            String
  label          String
  type           CustomFieldType
  // For SELECT/MULTI_SELECT: [{ value, label }, ...]
  options        Json?
  required       Boolean               @default(false)
  position       Int                   @default(0)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organisation Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  values       CustomFieldValue[]

  @@unique([organisationId, entityType, key])
  @@index([organisationId, entityType])
}

model CustomFieldValue {
  id             String                @id @default(cuid())
  organisationId String
  fieldId        String
  entityType     CustomFieldEntityType
  entityId       String
  valueText      String?
  valueNumber    Decimal?              @db.Decimal(18, 4)
  valueBoolean   Boolean?
  valueDate      DateTime?
  // For MULTI_SELECT: string[] of selected option values.
  valueJson      Json?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  field        CustomFieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  organisation Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([fieldId, entityId])
  @@index([organisationId, entityType, entityId])
}

// --- Sales pipeline (Phase 2A — reconciled Phase 2.2, see docs/DECISION_LOG.md) ---
// See docs/MASTER_ROADMAP.md "Phase 2A" and docs/DATABASE_SCHEMA.md §4 (Sales).

model Pipeline {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  isDefault      Boolean  @default(false)
  position       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation  Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  stages        PipelineStage[]
  opportunities Opportunity[]

  @@index([organisationId, position])
}

model PipelineStage {
  id         String   @id @default(cuid())
  pipelineId String
  name       String
  position   Int      @default(0)
  // Default forecasting weight (0-100) for opportunities in this stage that
  // don't set their own override — see Opportunity.probability.
  probability Int     @default(0)
  isWon      Boolean  @default(false)
  isLost     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  pipeline      Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]

  @@index([pipelineId, position])
}

enum OpportunityStatus {
  OPEN
  WON
  LOST
}

model Opportunity {
  id                String            @id @default(cuid())
  organisationId    String
  pipelineId        String
  stageId           String
  name              String
  companyId         String?
  contactId         String?
  ownerId           String?
  valueMinor        Int?
  currency          String            @default("GBP")
  // Per-opportunity override; falls back to PipelineStage.probability for
  // weighted forecasting when unset.
  probability       Int?
  expectedCloseDate DateTime?
  status            OpportunityStatus @default(OPEN)
  wonAt             DateTime?
  lostAt            DateTime?
  wonReason         String?
  lostReason        String?
  // Ordering within a Kanban column — persisted so drag-and-drop reorders
  // survive a reload, not just the stage move itself.
  position          Int               @default(0)
  tags              String[]          @default([])
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?

  organisation Organisation              @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  pipeline     Pipeline                  @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage        PipelineStage             @relation(fields: [stageId], references: [id], onDelete: Restrict)
  company      Company?                  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact      Contact?                  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  owner        Membership?               @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  stageHistory OpportunityStageHistory[]
  activities   Activity[]
  client       Client?
  proposals    Proposal[]
  contracts    Contract[]
  payments     Payment[]

  @@index([organisationId, status])
  @@index([organisationId, pipelineId, stageId, position])
  @@index([organisationId, ownerId])
  @@index([organisationId, deletedAt])
}

// Stage-move audit trail — same rationale as LeadOwnershipHistory: structured
// from/to querying ("time in each stage") that AuditLog's free-form metadata
// isn't indexed for.
model OpportunityStageHistory {
  id            String   @id @default(cuid())
  opportunityId String
  fromStageId   String?
  toStageId     String?
  changedAt     DateTime @default(now())

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId, changedAt])
}

// --- Activities & tasks (Phase 2A addition — not previously in docs/DATABASE_SCHEMA.md) ---
// Deliberately one polymorphic model for calls/meetings/emails/notes/tasks/
// reminders rather than separate Activity + Task tables: they share the same
// shape (type, optional due date, owner, completion state) and every "unified
// timeline" requirement in docs/MASTER_ROADMAP.md needs them queried
// together per entity anyway. A logged call/meeting/email/note is simply
// created with status COMPLETED and no dueAt; a task/reminder is created
// OPEN with a dueAt. See docs/DECISION_LOG.md and docs/DATABASE_SCHEMA.md §3.
// entityType/entityId follow the same polymorphic pattern as
// CustomFieldValue — resolved against entityType in the service layer, never
// a database-enforced foreign key.

enum ActivityEntityType {
  COMPANY
  CONTACT
  LEAD
  OPPORTUNITY
}

enum ActivityType {
  CALL
  MEETING
  EMAIL
  NOTE
  TASK
}

enum ActivityPriority {
  LOW
  MEDIUM
  HIGH
}

enum ActivityStatus {
  OPEN
  COMPLETED
  CANCELLED
}

model Activity {
  id              String             @id @default(cuid())
  organisationId  String
  entityType      ActivityEntityType
  entityId        String
  type            ActivityType
  subject         String
  body            String?
  dueAt           DateTime?
  priority        ActivityPriority   @default(MEDIUM)
  status          ActivityStatus     @default(OPEN)
  completedAt     DateTime?
  ownerId         String?
  createdByUserId String?
  // Optional: tag an activity against the deal it relates to even when the
  // activity's primary entity (entityType/entityId) is a Contact/Company.
  opportunityId   String?
  metadata        Json?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  owner        Membership?  @relation("ActivityOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  opportunity  Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@index([organisationId, entityType, entityId])
  @@index([organisationId, ownerId, status])
  @@index([organisationId, dueAt])
}

// --- Clients & lifecycle (Phase 2.3, reconciled 2026-11-27 — see docs/DECISION_LOG.md) ---
// A Client is created when an Opportunity is marked WON, not on payment
// capture (Phase 2.7's original trigger) — no payment provider is
// configured in this environment (CLAUDE.md: never fabricate a working
// integration), and "deal won" is a real signal that already exists.
// Payment capture remains a documented future integration point, not
// implemented here.

enum ClientLifecycleStage {
  PROSPECT
  QUALIFIED_PROSPECT
  OPPORTUNITY
  WON
  ONBOARDING
  ACTIVE
  GROWTH
  AT_RISK
  DORMANT
  OFFBOARDING
  FORMER
}

model Client {
  id                       String               @id @default(cuid())
  organisationId           String
  companyId                String?
  primaryContactId         String?
  originatingOpportunityId String?              @unique
  name                     String
  lifecycleStage           ClientLifecycleStage @default(WON)
  ownerId                  String?
  tags                     String[]             @default([])
  notes                    String?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  deletedAt                DateTime?

  organisation           Organisation            @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  company                Company?                @relation(fields: [companyId], references: [id], onDelete: SetNull)
  primaryContact         Contact?                @relation(fields: [primaryContactId], references: [id], onDelete: SetNull)
  originatingOpportunity Opportunity?            @relation(fields: [originatingOpportunityId], references: [id], onDelete: SetNull)
  owner                  Membership?             @relation("ClientOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  lifecycleHistory       ClientLifecycleHistory[]
  portalUsers            ClientPortalUser[]
  onboardings            ClientOnboarding[]
  documents              ClientDocument[]

  @@index([organisationId, lifecycleStage])
  @@index([organisationId, deletedAt])
}

model ClientLifecycleHistory {
  id            String                @id @default(cuid())
  clientId      String
  fromStage     ClientLifecycleStage?
  toStage       ClientLifecycleStage
  changedAt     DateTime              @default(now())
  changedByUserId String?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, changedAt])
}

// --- Service catalogue (Phase 2.4) ---

enum ServiceItemStatus {
  ACTIVE
  ARCHIVED
}

enum ServiceBillingType {
  ONE_OFF
  RECURRING
}

model ServiceItem {
  id             String             @id @default(cuid())
  organisationId String
  name           String
  description    String?
  sku            String?
  unitPriceMinor Int
  currency       String             @default("GBP")
  billingType    ServiceBillingType @default(ONE_OFF)
  status         ServiceItemStatus  @default(ACTIVE)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?

  organisation  Organisation               @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  priceHistory  ServiceItemPriceHistory[]
  proposalLines ProposalLine[]

  @@index([organisationId, status])
}

// Historical price snapshot — per docs/MASTER_ROADMAP.md 2.4's own
// "historical price snapshots" requirement, so a past proposal's line
// price never silently changes when the catalogue price updates later.
model ServiceItemPriceHistory {
  id             String   @id @default(cuid())
  serviceItemId  String
  unitPriceMinor Int
  currency       String
  effectiveFrom  DateTime @default(now())

  serviceItem ServiceItem @relation(fields: [serviceItemId], references: [id], onDelete: Cascade)

  @@index([serviceItemId, effectiveFrom])
}

// --- Proposals & quotations (Phase 2.5) ---
// E-signature (Phase 2.6) is a separate, not-yet-built capability —
// a vendor was never chosen (docs/MASTER_ROADMAP.md §4 lists it as
// "TBD, pending pricing/API review"). A Proposal here can be built,
// versioned, and shared via a secure public link; nothing here claims
// signing works.

enum ProposalStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED
}

model Proposal {
  id             String         @id @default(cuid())
  organisationId String
  opportunityId  String?
  companyId      String?
  contactId      String?
  title          String
  status         ProposalStatus @default(DRAFT)
  currency       String         @default("GBP")
  // Opaque, unguessable token for the secure public link — never the
  // record's own id, which could collide with an enumerable sequence.
  publicToken    String?        @unique
  sentAt         DateTime?
  viewedAt       DateTime?
  respondedAt    DateTime?
  expiresAt      DateTime?
  ownerId        String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  organisation Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  opportunity  Opportunity?      @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  company      Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact      Contact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  owner        Membership?       @relation("ProposalOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  versions     ProposalVersion[]

  @@index([organisationId, status])
}

model ProposalVersion {
  id            String   @id @default(cuid())
  proposalId    String
  versionNumber Int
  createdAt     DateTime @default(now())

  proposal Proposal       @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  lines    ProposalLine[]

  @@unique([proposalId, versionNumber])
}

model ProposalLine {
  id                String   @id @default(cuid())
  proposalVersionId String
  serviceItemId     String?
  description       String
  quantity          Int      @default(1)
  unitPriceMinor    Int
  position          Int      @default(0)

  proposalVersion ProposalVersion @relation(fields: [proposalVersionId], references: [id], onDelete: Cascade)
  serviceItem     ServiceItem?    @relation(fields: [serviceItemId], references: [id], onDelete: SetNull)

  @@index([proposalVersionId, position])
}

// --- Saved views / segments (Phase 2A advanced CRM) ---
// Reuses ActivityEntityType (COMPANY/CONTACT/LEAD/OPPORTUNITY) rather than
// a near-duplicate enum — this is exactly the set of list pages that need
// saved filters.

model SavedView {
  id             String             @id @default(cuid())
  organisationId String
  // Null = shared/org-wide view; set = private to that membership.
  ownerId        String?
  entityType     ActivityEntityType
  name           String
  // Serialized filter/sort state — interpreted by the relevant list page,
  // never executed as a query string server-side.
  filters        Json
  isDefault      Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  owner        Membership?  @relation("SavedViewOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([organisationId, entityType])
}

// --- Contracts & e-signature (Phase 2.6, docs/MASTER_ROADMAP.md) ---
// No real e-signature vendor is named in docs/ARCHITECTURE.md/.env.example
// (ESIGNATURE_API_KEY is explicitly "vendor TBD") — ESignatureProviderType
// has exactly one value (MOCK) today. The provider abstraction
// (src/modules/contracts/esignature-provider.ts) is written so a real
// vendor adapter is a new enum value + a new class implementing the same
// interface, not a schema change.

enum ContractTemplateStatus {
  ACTIVE
  ARCHIVED
}

model ContractTemplate {
  id             String                 @id @default(cuid())
  organisationId String
  name           String
  description    String?
  // The template body — plain text/markdown with {{variable}} placeholders
  // resolved at contract-creation time, never by an AI call (no invented
  // legal language — CLAUDE.md rule 4).
  bodyMarkdown   String
  status         ContractTemplateStatus @default(ACTIVE)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  deletedAt      DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contracts    Contract[]

  @@index([organisationId, status])
}

enum ContractStatus {
  DRAFT
  SENT
  VIEWED
  SIGNED
  DECLINED
  VOIDED
  EXPIRED
}

model Contract {
  id             String         @id @default(cuid())
  organisationId String
  templateId     String?
  opportunityId  String?
  companyId      String?
  contactId      String?
  title          String
  status         ContractStatus @default(DRAFT)
  // Opaque, unguessable token for the secure public link — same pattern as
  // Proposal.publicToken, never the record's own id.
  publicToken    String?        @unique
  sentAt         DateTime?
  viewedAt       DateTime?
  signedAt       DateTime?
  declinedAt     DateTime?
  voidedAt       DateTime?
  expiresAt      DateTime?
  ownerId        String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  organisation      Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  template          ContractTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  opportunity       Opportunity?       @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  company           Company?           @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact           Contact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)
  owner             Membership?        @relation("ContractOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  versions          ContractVersion[]
  signatureRequests SignatureRequest[]

  @@index([organisationId, status])
  @@index([organisationId, opportunityId])
}

// Versioned the same way as ProposalVersion — a new version is how a sent
// contract is "edited," the previous version's content is never mutated.
model ContractVersion {
  id            String   @id @default(cuid())
  contractId    String
  versionNumber Int
  content       String
  createdAt     DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, versionNumber])
}

enum SignatureRequestStatus {
  PENDING
  SIGNED
  DECLINED
  EXPIRED
}

enum ESignatureProviderType {
  MOCK
}

model SignatureRequest {
  id                String                 @id @default(cuid())
  contractId        String
  signerName        String
  signerEmail       String
  status            SignatureRequestStatus @default(PENDING)
  provider          ESignatureProviderType @default(MOCK)
  // Set once a real vendor is wired up — unique so an inbound webhook can
  // always resolve back to exactly one request.
  providerRequestId String?                @unique
  // The mock provider's "signature" is a typed full legal name plus the
  // signer's IP at the moment of signing — never a fabricated image/
  // biometric claim, consistent with "no compliance/certification claims"
  // (docs/MASTER_ROADMAP.md 2.6).
  signedName        String?
  signedIpAddress   String?
  signedAt          DateTime?
  declinedAt        DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
}

// --- Payments & gated conversion (Phase 2.7, docs/MASTER_ROADMAP.md) ---

enum PaymentProvider {
  STRIPE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Payment {
  id                    String          @id @default(cuid())
  organisationId        String
  opportunityId         String?
  companyId             String?
  contactId             String?
  provider              PaymentProvider @default(STRIPE)
  // Stripe's own PaymentIntent id — unique so a webhook retry or a second
  // intent for the same conceptual payment can never double-count.
  providerPaymentId     String          @unique
  amountMinor           Int
  currency              String          @default("GBP")
  status                PaymentStatus   @default(PENDING)
  failureReason         String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  opportunity  Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([organisationId, status])
  @@index([organisationId, opportunityId])
}

// --- Inbound webhook idempotency (shared by Stripe and, once a real
// e-signature vendor is wired up, that provider's webhooks too) ---

enum WebhookProvider {
  STRIPE
  ESIGNATURE_MOCK
}

model IncomingWebhookEvent {
  id              String          @id @default(cuid())
  provider        WebhookProvider
  // The provider's own event id (Stripe's evt_... id) — the dedupe key.
  // A webhook retried or redelivered with the same event id is a no-op on
  // its second+ delivery, never processed twice.
  externalEventId String
  receivedAt      DateTime        @default(now())
  payload         Json?

  @@unique([provider, externalEventId])
}

// --- AI gateway configuration & usage (Phase 2.8, docs/MASTER_ROADMAP.md,
// a narrow sales-context pull-forward from docs/AI_ARCHITECTURE.md — not
// the full agent framework/tool registry/RAG/autonomy-level model that doc
// also describes; those remain unbuilt, see docs/IMPLEMENTATION_STATUS.md) ---

enum AIProviderType {
  ANTHROPIC
  OPENAI
  GOOGLE
  OPENROUTER
}

model AIOrganisationConfig {
  id             String          @id @default(cuid())
  organisationId String          @unique
  provider       AIProviderType?
  model          String?
  // AES-256-GCM, keyed from AUTH_SECRET (src/lib/crypto.ts) — never
  // returned by any API response, never logged. Null means "use the
  // platform-level provider key" (ANTHROPIC_API_KEY etc. in .env) if one
  // is configured there instead of a per-org bring-your-own-key.
  encryptedApiKey String?
  enabled        Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
}

model AIUsageLog {
  id             String          @id @default(cuid())
  organisationId String
  // Which Phase 2.8 feature made the call — e.g. "lead_qualification",
  // "deal_risk", "next_best_action", "client_summary".
  feature        String
  provider       AIProviderType
  model          String
  inputTokens    Int             @default(0)
  outputTokens   Int             @default(0)
  succeeded      Boolean
  errorMessage   String?
  createdAt      DateTime        @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId, createdAt])
  @@index([organisationId, feature])
}

// --- Client Portal + Onboarding (Phase 3, docs/MASTER_ROADMAP.md) ---
// A client-portal principal (ClientPortalUser) is deliberately NOT a
// `User`/`Membership` row — it is a different kind of actor (an external
// client, not internal staff) and is never given a NextAuth session.
// Portal auth is a separate, minimal session mechanism (see
// src/modules/portal/auth.ts): a random session token's SHA-256 hash is
// the only thing ever stored, mirroring why API keys are encrypted rather
// than kept plaintext (src/lib/crypto.ts) — a database-only read can never
// yield a usable session. Invite tokens follow the existing, already-
// shipped Membership.inviteToken pattern (a unique opaque column, not a
// session) rather than inventing a second convention.

enum ClientPortalUserStatus {
  INVITED
  ACTIVE
  DISABLED
}

model ClientPortalUser {
  id             String                 @id @default(cuid())
  organisationId String
  clientId       String
  email          String
  name           String?
  passwordHash   String?
  status         ClientPortalUserStatus @default(INVITED)
  invitedAt      DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  invites               ClientPortalInvite[]
  sessions              ClientPortalSession[]
  uploadedDocuments     ClientDocument[]        @relation("DocumentUploadedByPortalUser")
  completedSteps        ClientOnboardingStep[]  @relation("StepCompletedByPortalUser")
  receivedNotifications Notification[]          @relation("NotificationRecipientPortalUser")

  @@unique([clientId, email])
  @@index([organisationId])
}

model ClientPortalInvite {
  id                 String    @id @default(cuid())
  clientPortalUserId String
  token              String    @unique
  expiresAt          DateTime
  acceptedAt         DateTime?
  createdAt          DateTime  @default(now())

  clientPortalUser ClientPortalUser @relation(fields: [clientPortalUserId], references: [id], onDelete: Cascade)

  @@index([clientPortalUserId])
}

// Session identifier is never stored raw — only its hash — so a copy of
// this table alone (backup, read replica, admin query) can never be used
// to impersonate a logged-in client.
model ClientPortalSession {
  id                 String   @id @default(cuid())
  clientPortalUserId String
  tokenHash          String   @unique
  expiresAt          DateTime
  createdAt          DateTime @default(now())
  lastSeenAt         DateTime @default(now())

  clientPortalUser ClientPortalUser @relation(fields: [clientPortalUserId], references: [id], onDelete: Cascade)

  @@index([clientPortalUserId])
}

enum OnboardingStepType {
  WELCOME
  CLIENT_INFO
  PROPOSAL_ACCEPTANCE
  CONTRACT_SIGNATURE
  PAYMENT
  DOCUMENT_UPLOAD
  QUESTIONNAIRE
  INTERNAL_REVIEW
  SERVICE_ACTIVATION
  CUSTOM
}

enum OnboardingAssignee {
  CLIENT
  INTERNAL
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum OnboardingStepStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
  BLOCKED
}

model OnboardingTemplate {
  id             String    @id @default(cuid())
  organisationId String
  name           String
  description    String?
  // At most one default per org — enforced in the service layer, same
  // exclusivity pattern already used for SavedView.isDefault.
  isDefault      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organisation Organisation             @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  steps        OnboardingTemplateStep[]
  onboardings  ClientOnboarding[]

  @@index([organisationId, deletedAt])
}

model OnboardingTemplateStep {
  id               String             @id @default(cuid())
  templateId       String
  order            Int
  label            String
  description      String?
  stepType         OnboardingStepType
  assignedTo       OnboardingAssignee @default(CLIENT)
  isMandatory      Boolean            @default(true)
  requiresApproval Boolean            @default(false)
  // Due date relative to the onboarding's startedAt — e.g. 3 means "3
  // days after onboarding starts", resolved once onto ClientOnboardingStep.dueAt.
  dueOffsetDays    Int?
  // Step-type-specific config — e.g. { questionnaire: [...] } for
  // QUESTIONNAIRE, { requiredCategories: [...] } for DOCUMENT_UPLOAD.
  // Never interpreted as anything beyond what the relevant step-type
  // renderer actually implements (CLAUDE.md rule 6).
  config           Json?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  template      OnboardingTemplate      @relation(fields: [templateId], references: [id], onDelete: Cascade)
  stepInstances ClientOnboardingStep[]

  @@index([templateId, order])
}

model ClientOnboarding {
  id          String           @id @default(cuid())
  clientId    String
  templateId  String
  status      OnboardingStatus @default(NOT_STARTED)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  client   Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  template OnboardingTemplate  @relation(fields: [templateId], references: [id], onDelete: Restrict)
  steps    ClientOnboardingStep[]

  @@index([clientId, status])
}

// Denormalised snapshot of the template step at the moment this
// onboarding was created — a later edit to the template can never
// silently change a step already presented to a client, the same
// versioning philosophy this project already applies to
// Proposal/ProposalVersion and Contract/ContractVersion.
model ClientOnboardingStep {
  id                      String                @id @default(cuid())
  onboardingId            String
  templateStepId          String
  order                   Int
  label                   String
  description             String?
  stepType                OnboardingStepType
  assignedTo              OnboardingAssignee
  isMandatory             Boolean
  requiresApproval        Boolean
  dueAt                   DateTime?
  status                  OnboardingStepStatus  @default(PENDING)
  // Step-specific captured data — e.g. questionnaire answers.
  data                    Json?
  completedAt             DateTime?
  completedByPortalUserId String?
  completedByMembershipId String?
  approvedByMembershipId  String?
  approvedAt              DateTime?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  onboarding            ClientOnboarding        @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  templateStep          OnboardingTemplateStep  @relation(fields: [templateStepId], references: [id], onDelete: Restrict)
  completedByPortalUser ClientPortalUser?       @relation("StepCompletedByPortalUser", fields: [completedByPortalUserId], references: [id], onDelete: SetNull)
  completedByMembership Membership?             @relation("StepCompletedByMembership", fields: [completedByMembershipId], references: [id], onDelete: SetNull)
  approvedByMembership  Membership?             @relation("StepApprovedByMembership", fields: [approvedByMembershipId], references: [id], onDelete: SetNull)
  documents             ClientDocument[]

  @@index([onboardingId, order])
}

enum DocumentUploadedByType {
  CLIENT
  INTERNAL
}

enum DocumentStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

// File content itself lives in S3-compatible object storage
// (docs/ARCHITECTURE.md §"storage"), never in Postgres — this row is
// metadata only. storageKey is an opaque, namespaced object key
// (org/{organisationId}/clients/{clientId}/documents/{cuid}), never a
// user-controlled path and never served from a public bucket URL —
// every download goes through a short-lived, permission-checked signed
// URL minted on demand (src/lib/storage.ts).
model ClientDocument {
  id                     String                 @id @default(cuid())
  organisationId         String
  clientId               String
  onboardingStepId       String?
  uploadedByType         DocumentUploadedByType
  uploadedByPortalUserId String?
  uploadedByMembershipId String?
  category               String?
  originalFilename       String
  storageKey             String                 @unique
  mimeType               String
  sizeBytes              Int
  status                 DocumentStatus         @default(PENDING_REVIEW)
  reviewedByMembershipId String?
  reviewedAt             DateTime?
  createdAt              DateTime               @default(now())
  deletedAt              DateTime?

  organisation         Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  client               Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  onboardingStep       ClientOnboardingStep? @relation(fields: [onboardingStepId], references: [id], onDelete: SetNull)
  uploadedByPortalUser ClientPortalUser?     @relation("DocumentUploadedByPortalUser", fields: [uploadedByPortalUserId], references: [id], onDelete: SetNull)
  uploadedByMembership Membership?           @relation("DocumentUploadedByMembership", fields: [uploadedByMembershipId], references: [id], onDelete: SetNull)
  reviewedByMembership Membership?           @relation("DocumentReviewedByMembership", fields: [reviewedByMembershipId], references: [id], onDelete: SetNull)

  @@index([organisationId, clientId, deletedAt])
  @@index([onboardingStepId])
}

enum NotificationRecipientType {
  MEMBERSHIP
  CLIENT_PORTAL_USER
}

enum NotificationType {
  ONBOARDING_STEP_DUE
  ONBOARDING_STEP_COMPLETED
  ONBOARDING_COMPLETED
  DOCUMENT_UPLOADED
  DOCUMENT_REVIEWED
  PORTAL_INVITE_SENT
  GENERAL
}

// In-app only — no email/SMS delivery exists in this project (see
// "Known limitations" in docs/IMPLEMENTATION_STATUS.md), so a
// Notification row is never presented as "sent" to anyone, only
// rendered in-app for its one real recipient.
model Notification {
  id                    String                     @id @default(cuid())
  organisationId        String
  recipientType         NotificationRecipientType
  recipientMembershipId String?
  recipientPortalUserId String?
  type                  NotificationType
  title                 String
  body                  String?
  href                  String?
  readAt                DateTime?
  createdAt             DateTime                   @default(now())

  organisation        Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  recipientMembership Membership?       @relation("NotificationRecipientMembership", fields: [recipientMembershipId], references: [id], onDelete: Cascade)
  recipientPortalUser ClientPortalUser? @relation("NotificationRecipientPortalUser", fields: [recipientPortalUserId], references: [id], onDelete: Cascade)

  @@index([organisationId, recipientMembershipId, readAt])
  @@index([organisationId, recipientPortalUserId, readAt])
}
