# EncifOne — environment variable reference. Copy to .env and fill in real
# values for local dev. Never commit .env. See docs/DEPLOYMENT.md §6 for the
# full operational explanation of each variable and docs/DECISION_LOG.md for
# why this classification exists (a missing/misrouted variable is the
# single most common cause of deployment incidents on this project so far).
#
# Classification used throughout this file:
#   [BUILD]    read during `next build` / `prisma generate` — never a real
#              secret; the Dockerfile supplies safe placeholders itself.
#   [RUNTIME]  required for the app and/or worker container to start.
#   [OPTIONAL] an integration that must be safely absent — the app must
#              start normally without it, with that integration simply
#              inactive (see "Optional integrations must not block startup"
#              in docs/DEPLOYMENT.md §6).
#   [DEV-ONLY] only meaningful for local development.
#   [SECRET]   never log, never put in an error response, never commit.

# --- App [RUNTIME] ---
NODE_ENV=development
# [RUNTIME] Canonical public URL of this deployment. Also the fallback
# source for NEXTAUTH_URL (src/lib/env.ts ensureNextAuthUrl()) if that's
# not set separately. Must be the real https:// production domain in
# production — never localhost.
APP_URL=http://localhost:3000
# Communications callbacks and the chat snippet use this canonical app origin.
# Enter Resend and Twilio credentials per organisation in Communication settings.
# The widget and reminder worker reuse the existing Redis connection.
# Saved integrations also depend on the stable AUTH_SECRET for encryption.
# [RUNTIME] Informational only — platform branding is centralised in
# src/config/branding.ts and does not currently read this at runtime.
APP_NAME="EncifOne"
# [RUNTIME] Must match the app's actual listening port. Baked into the
# Docker image (ENV PORT=3000) and also set explicitly in
# docker-compose.yml for belt-and-suspenders clarity — only change this if
# you also change the Dockerfile's EXPOSE/compose port mapping to match.
PORT=3000
# [RUNTIME] Explicit, not left to Next's own default — see
# docs/DECISION_LOG.md for the production incident this fixes (Next's
# standalone server binds to this value if set; Docker sets it to the
# container's own id by default, which is NOT what you want).
HOSTNAME=0.0.0.0

# --- Database [RUNTIME] ---
# Standard: PostgreSQL 18 + pgvector, everywhere (see docs/DECISION_LOG.md).
# Locally this is the `pgvector/pgvector:pg18` container defined in
# docker-compose.local.yml (NOT docker-compose.yml alone — see README.md).
# Host ports are remapped (5433/6380 by default) to avoid colliding with
# another local Postgres/Redis — adjust if you've changed
# POSTGRES_HOST_PORT / REDIS_HOST_PORT, or if running against a
# differently-configured instance. In production this points at a
# separately-provisioned Coolify-managed PostgreSQL 18 + pgvector instance,
# reached via its Coolify "Internal URL" over the predefined network — see
# docs/DEPLOYMENT.md §5 — never a value that matches these local defaults,
# and never the database's public/external URL.
# [SECRET]
DATABASE_URL=postgresql://clientos:clientos_dev_password@localhost:5433/clientos

# --- Redis [RUNTIME] ---
# Note: the app/worker containers always reach Redis via the internal
# compose service name (redis://redis:6379), hardcoded in docker-compose.yml
# — this variable is for host-side tooling (local scripts, `pnpm dev`) only.
REDIS_URL=redis://localhost:6380

# --- Auth [RUNTIME, SECRET] ---
# [SECRET] 16+ characters. Passed explicitly as NextAuth's `secret` option
# (src/lib/auth.ts) — NextAuth v4 does NOT automatically pick this up under
# this name; only under NEXTAUTH_SECRET, which this project does not use.
AUTH_SECRET=replace-with-a-long-random-string
# [RUNTIME, optional to set explicitly] NextAuth v4's own canonical public
# base URL, used to build OAuth/callback/cookie URLs correctly behind a
# reverse proxy. If unset, src/lib/env.ts defaults it from APP_URL — only
# set this separately if it must genuinely differ from APP_URL. Must be
# https:// in production for secure cookies to be issued correctly.
NEXTAUTH_URL=
# [OPTIONAL] Google OAuth — absent means the provider simply isn't
# registered (src/lib/auth.ts checks both are present before adding it).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# [OPTIONAL] Not yet wired into src/lib/auth.ts — reserved for a future
# Microsoft OAuth provider (docs/PRODUCT_REQUIREMENTS.md). Setting these
# today has no effect.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- Object storage [OPTIONAL] — not yet wired into any code path ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# --- AI providers [OPTIONAL] — not yet wired into any code path (ai-gateway, docs/MASTER_ROADMAP.md Phase 2.8+) ---
AI_DEFAULT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
OPENROUTER_API_KEY=

# --- Payments [OPTIONAL] — not yet wired into any code path (docs/MASTER_ROADMAP.md Phase 2.7) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Customer invoice collection through Stripe Connect, separate from CRM deposits.
STRIPE_CONNECT_SECRET_KEY=
STRIPE_CONNECT_WEBHOOK_SECRET=
GOCARDLESS_ACCESS_TOKEN=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- Accounting integrations [OPTIONAL] — not yet wired into any code path ---
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=

# --- Communication integrations [OPTIONAL] — not yet wired into any code path ---
RESEND_API_KEY=
FINANCE_EMAIL_FROM=
POSTMARK_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WHATSAPP_BUSINESS_TOKEN=

# --- E-signature [OPTIONAL] — vendor TBD, see docs/MASTER_ROADMAP.md Phase 2.6 ---
ESIGNATURE_API_KEY=

# --- Error monitoring [OPTIONAL] ---
SENTRY_DSN=

# --- Feature/runtime flags [DEV-ONLY] ---
ENABLE_LOCAL_MODEL=false

# --- Local-dev-only convenience (docker-compose.local.yml) [DEV-ONLY] ---
# Never set these in production — they have no effect in docker-compose.yml.
POSTGRES_USER=clientos
POSTGRES_PASSWORD=clientos_dev_password
POSTGRES_DB=clientos
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
