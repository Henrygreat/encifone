# EncifOne — environment variable skeleton (Phase 1 target; not all vars are wired up yet)
# Copy to .env and fill in real values. Never commit .env.
# Platform branding (product name, taglines) is centralised in
# src/config/branding.ts — APP_NAME here is informational only, not yet
# wired up as a runtime override.

# --- App ---
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME="EncifOne"

# --- Database ---
# Host ports are remapped in docker-compose.yml (5433/6380 by default) to
# avoid colliding with another local Postgres/Redis — adjust if you've
# changed POSTGRES_HOST_PORT / REDIS_HOST_PORT, or if running against a
# differently-configured instance.
DATABASE_URL=postgresql://clientos:clientos_dev_password@localhost:5433/clientos

# --- Redis (cache, rate limiting, BullMQ) ---
REDIS_URL=redis://localhost:6380

# --- Auth ---
AUTH_SECRET=replace-with-a-long-random-string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- Object storage (S3-compatible) ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# --- AI providers (ai-gateway) ---
AI_DEFAULT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
OPENROUTER_API_KEY=

# --- Payments ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOCARDLESS_ACCESS_TOKEN=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- Accounting integrations ---
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=

# --- Communication integrations ---
RESEND_API_KEY=
POSTMARK_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WHATSAPP_BUSINESS_TOKEN=

# --- E-signature (vendor TBD — see docs/ROADMAP.md) ---
ESIGNATURE_API_KEY=

# --- Error monitoring ---
SENTRY_DSN=

# --- Feature/runtime flags ---
ENABLE_LOCAL_MODEL=false
